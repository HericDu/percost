# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# 管理后台入口路径
# 访问 https://你的域名/<ADMIN_PATH> 才会显示登录页，其余路径均返回 404。
# 该值不会下发到前端，无法从页面源码中读取。
# 生成随机路径：openssl rand -hex 12
# 注意：这是为了降低被自动化扫描命中的概率，不能替代强密码。
ADMIN_PATH=login

# JWT 配置
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change_in_production
TOKEN_EXPIRE_DAYS=7

# 数据库配置（可选，默认使用 SQLite）
# DATABASE_URL=sqlite:///data/percost.db

# CORS 配置（单容器部署下前后端同源，一般填实际访问地址即可）
CORS_ORIGINS=http://localhost:12800
